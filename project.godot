; Fichier de configuration du projet Godot (YaKaFauKon).

config_version=5

[application]

config/name="YaKaFauKon"
config/description="Jeu de simulation de vie pour apprendre la frappe au clavier en ergothérapie."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[audio]

general/text_to_speech=true

[autoload]

Game="*res://scripts/core/game.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom_font="res://fonts/Lexend.ttf"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
